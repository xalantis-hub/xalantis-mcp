{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.xalantis-hub/xalantis-mcp",
  "title": "Xalantis",
  "description": "Tickets, CRM, contracts, projects and the whole Xalantis public API from your AI assistant.",
  "websiteUrl": "https://xalantis.com",
  "repository": {
    "url": "https://github.com/xalantis-hub/xalantis-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://xalantis.com/favicon-512x512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://xalantis.com/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "version": "0.3.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@xalantis/mcp-server",
      "version": "0.3.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "XALANTIS_API_KEY",
          "description": "API key of your Xalantis organization (Organization settings > Developers > API keys).",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "XALANTIS_BASE_URL",
          "description": "Xalantis instance to target. Defaults to https://xalantis.com/api/v1.",
          "isRequired": false,
          "isSecret": false,
          "format": "string",
          "default": "https://xalantis.com/api/v1"
        }
      ]
    }
  ]
}
