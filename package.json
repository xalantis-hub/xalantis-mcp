{
  "name": "@xalantis/mcp-server",
  "mcpName": "io.github.xalantis-hub/xalantis-mcp",
  "version": "0.3.1",
  "description": "MCP server for Xalantis — tickets, CRM, contracts, projects and the whole public API from Claude, Cursor, and other AI tools",
  "homepage": "https://xalantis.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xalantis-hub/xalantis-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/xalantis-hub/xalantis-mcp/issues"
  },
  "type": "module",
  "bin": {
    "xalantis-mcp": "./build/index.js"
  },
  "main": "build/index.js",
  "files": [
    "build",
    "openapi"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "lint": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.mjs",
    "sync-openapi": "node scripts/sync-openapi.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "xalantis",
    "mcp",
    "model-context-protocol",
    "tickets",
    "support",
    "ai",
    "projects",
    "crm",
    "contracts",
    "openapi"
  ],
  "author": "WAZMINE <dev@xalantis.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
